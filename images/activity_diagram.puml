@startuml Activity_Diagram

!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontName "Arial"
skinparam defaultFontSize 11

title **Activity Diagram**\nAlur Pelaporan Aktivitas Harian

|Petugas Perekaman|
start
:Verifikasi Dokumen\n(KK & Akta Kelahiran);
if (Dokumen Valid?) then (Ya)
    :Input Data ke Aplikasi SIAK;
    :Perekaman Biometric\n(Sidik Jari, Iris, Foto);
    :Input Aktivitas Harian\nke Sistem;
    :Submit Laporan;
else (Tidak)
    :Kembalikan ke Pemohon;
    stop
endif

|Administrator Database|
:Terima Laporan;
:Verifikasi Data;
if (Data Lengkap?) then (Ya)
    :Update Status;
    :Kirim Notifikasi Email\nke Pemohon;
else (Tidak)
    :Kembalikan ke Petugas;
endif

|Kabid PIAK|
:Review Laporan;
if (Disetujui?) then (Ya)
    :Approve Laporan;
    :Update Dashboard;
else (Tidak)
    :Revisi;
endif

|Kepala Dinas|
:Lihat Dashboard\nIndikator Kinerja;
:Export Laporan Bulanan;

stop

@enduml
